+static void write_mission_telemetry(void) {
+	FILE *f = fopen("/tmp/mission_telemetry.csv.tmp", "w");
+
+	time_t now = time(NULL);
+	struct tm utc;
+	gmtime_r(&now, &utc);
+
+	fprintf(
+		f,
+		"%04d-%02d-%02dT%02d:%02d:%02dZ,%.7f,%.7f,%d,%d,%d\n",
+		utc.tm_year + 1900,
+		utc.tm_mon + 1,
+		utc.tm_mday,
+		utc.tm_hour,
+		utc.tm_min,
+		utc.tm_sec,
+		last_latitude / 10000000.0,
+		last_longitude / 10000000.0,
+		last_altitude,
+		last_groundCourse,
+		last_speed
+	);
+
+	fclose(f);
+	rename("/tmp/mission_telemetry.csv.tmp", "/tmp/mission_telemetry.csv");
+}
